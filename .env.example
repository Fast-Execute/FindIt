# Supabase project (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. NEVER expose this to the browser or prefix it with NEXT_PUBLIC_.
# Used by the device token and location API routes and the stale-device job.
SUPABASE_SERVICE_ROLE_KEY=

# Long random string (for example: openssl rand -base64 32). The scheduler sends it as
# "Authorization: Bearer <CRON_SECRET>" when calling /api/cron/stale-devices.
CRON_SECRET=
