NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for /api/cron/mark-offline (sent as "Authorization: Bearer <secret>").
CRON_SECRET=

# Public site URL, used for PayFast return and notify URLs (no trailing slash).
NEXT_PUBLIC_SITE_URL=
# PayFast. Runs in sandbox unless PAYFAST_MODE=live.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox

# Email (Resend). Without these, alerts stay queued and nothing is lost.
RESEND_API_KEY=
# A sender on a domain you have verified with Resend, e.g. "FindIt <alerts@yourdomain.co.za>".
EMAIL_FROM=
