        0,
        0
      ],
      "webhookId": "8f24e391-80d2-46d9-9102-a61bce0cac80",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "FindIt webhook secret"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "949a295c-406f-4959-a31d-ec8874cadc5f",
              "name": "supabaseUrl",
              "value": "https://YOUR-PROJECT.supabase.co",
              "type": "string"
            },
            {
              "id": "b86237b8-c5dd-4db0-bcc8-eb0631338715",
              "name": "siteUrl",
              "value": "https://YOUR-FINDIT-SITE",
              "type": "string"
            },
            {
              "id": "4e26b328-927a-468a-8883-c9ac518ff24f",
